# Public address of this site. Used for canonical URLs, the sitemap, structured data and email links.
SITE_URL=https://caterkwik.awecreative.co.uk

# Staging password. With this unset the gate is off (local development).
SITE_PASSWORD=

# Production only: lets search engines index the site (robots.txt, meta robots, X-Robots-Tag).
# ALLOW_INDEXING=true

# Database. docker compose builds DATABASE_URL from DB_PASSWORD; set it yourself when running without Docker
# (npm run db:dev starts a local Postgres at this address).
DB_PASSWORD=
# DATABASE_URL=postgresql://postgres:postgres@localhost:54320/caterkwik

# Email. Without SMTP_URL, mail is written to the server log instead of sent.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=Caterkwik <no-reply@caterkwik.co.uk>
SALES_EMAIL=sales@caterkwik.co.uk

# Card payments. Without these, orders are taken for payment by the team.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Media server: product images and PDFs are uploaded here over SFTP and served by the app at /media/....
# MEDIA_SFTP_HOST=178.128.174.180
# MEDIA_SFTP_PORT=22
# MEDIA_SFTP_USER=
# MEDIA_SFTP_PASSWORD=
# MEDIA_REMOTE_DIR=/mnt/media
# Required in production: the server host key, from `ssh-keyscan -t ed25519 HOST | ssh-keygen -lf -`
# MEDIA_SFTP_HOST_FINGERPRINT=SHA256:...
# MEDIA_BASE_URL=   (leave unset: the app serves the files itself at /media/...)

# Kit, the product expert. Without a key he answers "not configured".
ANTHROPIC_API_KEY=
# The admin assistant uses the same key.
# ADMIN_AI_MODEL=claude-opus-5-5
# ADMIN_AI_FALLBACK_MODEL=claude-sonnet-5-5

# KIT_MODEL=claude-opus-5-5
# KIT_FALLBACK_MODEL=claude-sonnet-5-5

# Competitor price checks. The nightly scheduler (deploy/competitor-check.sh) sends this as a bearer token.
# Without it the endpoint answers 503. Generate one with: openssl rand -hex 32
CRON_SECRET=
