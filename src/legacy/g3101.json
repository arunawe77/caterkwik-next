{"ld":[],"main":"<main class=\"wrap\">\r\n  <p class=\"crumbs\"><a href=\"#\">Home</a> / <a href=\"#\">Cooking</a> / <a href=\"#\">Oven Ranges</a> / <a href=\"#\">Falcon</a> / Dominator Plus G3101 OTC/P</p>\r\n\r\n  <!-- ───────── hero ───────── -->\r\n  <div class=\"hero\">\r\n\r\n    <!-- gallery -->\r\n    <div class=\"gallery\">\r\n      <div class=\"stage\" id=\"stage\">\r\n        <div class=\"flag\">\r\n          <span class=\"chip chip-green\">In stock</span>\r\n          <span class=\"chip\">British built</span>\r\n        </div>\r\n        <div class=\"brandmark\"><img src=\"/assets/img/falcon.webp\" alt=\"\">Dominator Plus</div>\r\n        <img id=\"hero-img\" src=\"/assets/img/g3101-otc-p.jpg\" alt=\"Falcon Dominator Plus G3101 OTC/P six burner oven range\">\r\n        <div class=\"dimsview\" id=\"dimsview\">\r\n          <svg viewBox=\"0 0 460 400\" width=\"100%\" height=\"100%\" role=\"img\" aria-label=\"Scale drawing: 900 mm wide, 943 mm high, 857 mm deep\">\r\n            <defs>\r\n              <marker id=\"a\" markerWidth=\"9\" markerHeight=\"9\" refX=\"8\" refY=\"4.5\" orient=\"auto\"><path d=\"M0 0.5 8 4.5 0 8.5z\" fill=\"#15202B\"/></marker>\r\n              <marker id=\"b\" markerWidth=\"9\" markerHeight=\"9\" refX=\"1\" refY=\"4.5\" orient=\"auto\"><path d=\"M9 0.5 1 4.5 9 8.5z\" fill=\"#15202B\"/></marker>\r\n            </defs>\r\n            <g stroke=\"#15202B\" fill=\"none\" stroke-width=\"1.6\">\r\n              <!-- body -->\r\n              <rect x=\"72\" y=\"96\" width=\"250\" height=\"212\" rx=\"3\" fill=\"#F5F7FA\"/>\r\n              <!-- hob top -->\r\n              <rect x=\"66\" y=\"82\" width=\"262\" height=\"16\" rx=\"2\" fill=\"#E3E8EE\"/>\r\n              <!-- splash rail -->\r\n              <path d=\"M66 82v-14h262v14\"/>\r\n              <!-- control panel -->\r\n              <line x1=\"72\" y1=\"132\" x2=\"322\" y2=\"132\"/>\r\n              <g fill=\"#15202B\" stroke=\"none\">\r\n                <circle cx=\"98\" cy=\"115\" r=\"6\"/><circle cx=\"128\" cy=\"115\" r=\"6\"/><circle cx=\"158\" cy=\"115\" r=\"6\"/>\r\n                <circle cx=\"236\" cy=\"115\" r=\"6\"/><circle cx=\"266\" cy=\"115\" r=\"6\"/><circle cx=\"296\" cy=\"115\" r=\"6\"/>\r\n              </g>\r\n              <!-- oven doors -->\r\n              <rect x=\"86\" y=\"146\" width=\"108\" height=\"148\" rx=\"2\"/>\r\n              <rect x=\"200\" y=\"146\" width=\"108\" height=\"148\" rx=\"2\"/>\r\n              <rect x=\"100\" y=\"176\" width=\"80\" height=\"96\" rx=\"2\" fill=\"#E3E8EE\"/>\r\n              <rect x=\"214\" y=\"176\" width=\"80\" height=\"96\" rx=\"2\" fill=\"#E3E8EE\"/>\r\n              <path d=\"M104 160h72M218 160h72\" stroke-width=\"4\" stroke-linecap=\"round\"/>\r\n              <!-- legs -->\r\n              <path d=\"M92 308v22M302 308v22\" stroke-width=\"5\"/>\r\n              <!-- width dimension -->\r\n              <path d=\"M66 356h262\" marker-start=\"url(#b)\" marker-end=\"url(#a)\"/>\r\n              <path d=\"M66 344v20M328 344v20\" stroke-width=\"1\"/>\r\n              <!-- height dimension -->\r\n              <path d=\"M382 68v262\" marker-start=\"url(#b)\" marker-end=\"url(#a)\"/>\r\n              <path d=\"M370 68h24M370 330h24\" stroke-width=\"1\"/>\r\n            </g>\r\n            <g font-family=\"Roboto, sans-serif\" fill=\"#15202B\">\r\n              <text x=\"197\" y=\"380\" font-size=\"17\" font-weight=\"900\" text-anchor=\"middle\">900 mm wide</text>\r\n              <text x=\"404\" y=\"205\" font-size=\"17\" font-weight=\"900\" text-anchor=\"middle\" transform=\"rotate(90 404 205)\">943 mm high</text>\r\n              <text x=\"197\" y=\"48\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#10498A\">857 mm deep · 115 kg</text>\r\n              <text x=\"197\" y=\"66\" font-size=\"12\" text-anchor=\"middle\" fill=\"#15202B\" opacity=\".55\">Oven chamber 700 × 535 × 430 mm (2/1 GN)</text>\r\n            </g>\r\n          </svg>\r\n        </div>\r\n        <div class=\"modes\" role=\"group\" aria-label=\"View\">\r\n          <button type=\"button\" data-mode=\"product\" aria-pressed=\"true\">Product</button>\r\n          <button type=\"button\" data-mode=\"burner\" aria-pressed=\"false\">Burners</button>\r\n          <button type=\"button\" data-mode=\"dims\" aria-pressed=\"false\">Dimensions</button>\r\n        </div>\r\n      </div>\r\n      <div class=\"thumbs\">\r\n        <button type=\"button\" aria-pressed=\"true\" data-mode=\"product\"><img src=\"/assets/img/g3101-otc-p.jpg\" alt=\"Full range\"></button>\r\n        <button type=\"button\" aria-pressed=\"false\" data-mode=\"burner\"><img src=\"/assets/img/g3101-otc-p-2.jpg\" alt=\"Open top burner\"></button>\r\n        <button type=\"button\" aria-pressed=\"false\" data-mode=\"dims\"><span class=\"dimthumb\">900 × 857<br>× 943 mm</span></button>\r\n        <button type=\"button\" aria-pressed=\"false\" data-mode=\"natural\"><img src=\"/assets/img/g3101-otc-n.jpg\" alt=\"Natural gas version\"></button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- buy column -->\r\n    <div>\r\n      <p class=\"eyebrow\">Falcon · Dominator Plus</p>\r\n      <h1>G3101 OTC/P 6 Burner Propane Gas Range, Fan-Assisted Electric Oven</h1>\r\n      <div class=\"metaline\">\r\n        <span class=\"feefo\"><span class=\"stars\">★★★★★</span> Feefo Platinum</span>\r\n        <span>·</span>\r\n        <span>MPN <b>G3101 OTC/P</b></span>\r\n        <span>·</span>\r\n        <span>Multi-phase · Dual fuel</span>\r\n      </div>\r\n\r\n      <div class=\"card pricecard\">\r\n        <div class=\"pricerow\">\r\n          <span class=\"price\" data-price>£3,097.99</span>\r\n          <span class=\"was\" data-was>£7,355.00</span>\r\n          <span class=\"saving\" data-saving>Save £4,257.01</span>\r\n        </div>\r\n        <p class=\"pricenote\" data-vatnote><b>Excluding VAT.</b> £3,717.59 including VAT at 20%. RRP £7,355.00 ex VAT.</p>\r\n\r\n        <ul class=\"pricelines\">\r\n          <li><svg class=\"ok\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\"><path d=\"M20 6 9 17l-5-5\"/></svg><span><b>In stock.</b> 3 to 5 working days, free delivery.</span></li>\r\n          <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M3 7h11v9H3zM14 10h4l3 3v3h-7z\"/><circle cx=\"7\" cy=\"18\" r=\"1.6\"/><circle cx=\"17.5\" cy=\"18\" r=\"1.6\"/></svg><span>128 kg packaged, so delivery is <b>kerbside</b> unless we install it. <a href=\"#delivery\">What that means</a></span></li>\r\n          <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg><span>Gas Safe and electrical connection by our own engineers. <a href=\"#install\">Check your kitchen</a></span></li>\r\n          <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"2.5\" y=\"5.5\" width=\"19\" height=\"13\" rx=\"2\"/><path d=\"M2.5 10h19\"/></svg><span>iwocaPay: 3 payments of <b data-iwoca>£1,239.20</b> inc VAT. Lease from £17.32 a week.</span></li>\r\n        </ul>\r\n      </div>\r\n\r\n      <!-- the two decisions that get this order wrong -->\r\n      <div class=\"picker\">\r\n        <div class=\"head\">\r\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"><path d=\"M12 2 4 6v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6z\"/><path d=\"M9 12h6M12 9v6\"/></svg>\r\n          <b>Get the fuel and the phase right first</b>\r\n        </div>\r\n        <div class=\"body\">\r\n          <div class=\"pickset\">\r\n            <span>Gas supply at your site</span>\r\n            <div class=\"opts\">\r\n              <button class=\"opt\" type=\"button\" data-fuel=\"lpg\" aria-pressed=\"true\"><b>Propane (LPG)</b><span>Bottled gas, mobile units, rural sites</span></button>\r\n              <button class=\"opt\" type=\"button\" data-fuel=\"natural\" aria-pressed=\"false\"><b>Natural gas</b><span>Mains gas from the meter</span></button>\r\n            </div>\r\n          </div>\r\n          <div class=\"pickset\">\r\n            <span>Electrical supply for the oven</span>\r\n            <div class=\"opts\">\r\n              <button class=\"opt\" type=\"button\" data-phase=\"single\" aria-pressed=\"true\"><b>Single phase 230V</b><span>Needs a 30A hardwired way</span></button>\r\n              <button class=\"opt\" type=\"button\" data-phase=\"three\" aria-pressed=\"false\"><b>Three phase 400V</b><span>L1 14.3A, L2 13.9A</span></button>\r\n            </div>\r\n          </div>\r\n          <p class=\"pickout\" id=\"pickout\"></p>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"trust\">\r\n        <h3>\r\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" width=\"16\" height=\"16\"><path d=\"M12 3 4 6v5c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6z\"/></svg>\r\n          Bought from an equipment specialist, not a box shifter\r\n        </h3>\r\n        <ul>\r\n          <li>Family run in Cumbria since 1994</li>\r\n          <li>Feefo Platinum Trusted Service</li>\r\n          <li>Our own survey and design team</li>\r\n          <li>Our own delivery vehicles</li>\r\n          <li>Certified installation and service</li>\r\n          <li>Price match promise</li>\r\n        </ul>\r\n      </div>\r\n\r\n      <!-- key specs -->\r\n      <section style=\"padding:32px 0 0;border:0\">\r\n        <div class=\"sechead\" style=\"margin-bottom:6px\">\r\n          <h2 style=\"font-size:14px;text-transform:uppercase;letter-spacing:.08em\">Key specifications</h2>\r\n          <a class=\"small\" href=\"#specifications\" style=\"font-weight:700;color:var(--blue);text-decoration:none\">All 21 specifications →</a>\r\n        </div>\r\n        <div class=\"specgrid\">\r\n          <div><span>Burners</span><span>6 × 5.3 kW</span></div>\r\n          <div><span>Total gas rating</span><span>31.8 kW</span></div>\r\n          <div><span>Oven</span><span>Fan-assisted, 2/1 GN</span></div>\r\n          <div><span>Oven temperature</span><span>+120 to +270 °C</span></div>\r\n          <div><span>Electrical rating</span><span>6.5 kW</span></div>\r\n          <div><span>External size</span><span>943 × 900 × 857 mm</span></div>\r\n          <div><span>Weight</span><span>115 kg</span></div>\r\n          <div><span>Warranty</span><span>2 years parts &amp; labour</span></div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- accessories -->\r\n      <section style=\"padding:32px 0 0;border:0\">\r\n        <div class=\"sechead\" style=\"margin-bottom:14px\">\r\n          <h2 style=\"font-size:14px;text-transform:uppercase;letter-spacing:.08em\">Add what it needs on the day</h2>\r\n        </div>\r\n        <div class=\"acc\" style=\"grid-template-columns:repeat(2,minmax(0,1fr))\">\r\n\r\n          <div class=\"acccard\" data-acc=\"castors\" data-name=\"Loose castors, set of 4\" data-price=\"84.99\">\r\n            <div class=\"accimg\">\r\n              <span class=\"chip chip-green best\">Most added</span>\r\n              <img src=\"/assets/img/acc-castors.jpg\" alt=\"\">\r\n            </div>\r\n            <h3>Loose castors, set of 4</h3>\r\n            <p>535400211. Lets you pull 115 kg out to clean behind it. Environmental health will thank you.</p>\r\n            <div class=\"accfoot\">\r\n              <span class=\"accprice\" data-accprice>+ £84.99</span>\r\n              <button class=\"btn btn-ghost btn-sm\" type=\"button\" data-add>Add</button>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"acccard\" data-acc=\"splashback\" data-name=\"Splashback &amp; plate shelf\" data-price=\"128.99\">\r\n            <div class=\"accimg\"><img src=\"/assets/img/acc-splashback.jpg\" alt=\"\"></div>\r\n            <h3>Splashback &amp; plate shelf</h3>\r\n            <p>525290005, sized for the 900 mm range. Somewhere to land plates, and a wall you can wipe.</p>\r\n            <div class=\"accfoot\">\r\n              <span class=\"accprice\" data-accprice>+ £128.99</span>\r\n              <button class=\"btn btn-ghost btn-sm\" type=\"button\" data-add>Add</button>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"acccard\" data-acc=\"shelf\" data-name=\"Additional oven shelf\" data-price=\"105.99\">\r\n            <div class=\"accimg\"><img src=\"/assets/img/acc-shelf.jpg\" alt=\"\"></div>\r\n            <h3>Additional oven shelf</h3>\r\n            <p>525290004. Two come with the range and there are five shelf positions, so there is room for more.</p>\r\n            <div class=\"accfoot\">\r\n              <span class=\"accprice\" data-accprice>+ £105.99</span>\r\n              <button class=\"btn btn-ghost btn-sm\" type=\"button\" data-add>Add</button>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"acccard\" data-acc=\"tray\" data-name=\"2/1 GN tray, 100 mm\" data-price=\"27.99\">\r\n            <div class=\"accimg\"><img src=\"/assets/img/acc-gn-tray.jpg\" alt=\"\"></div>\r\n            <h3>2/1 GN tray, 100 mm</h3>\r\n            <p>K804 stainless steel. The oven takes full 2/1 trays, which is the whole point of it.</p>\r\n            <div class=\"accfoot\">\r\n              <span class=\"accprice\" data-accprice>+ £27.99</span>\r\n              <button class=\"btn btn-ghost btn-sm\" type=\"button\" data-add>Add</button>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"acccard\" data-acc=\"canopy\" data-name=\"SmartVent SV1212 canopy\" data-price=\"2031.99\" style=\"grid-column:1/-1\">\r\n            <div class=\"accimg\" style=\"aspect-ratio:16/6\"><img src=\"/assets/img/acc-canopy.jpg\" alt=\"\"></div>\r\n            <h3>SmartVent SV1212 extraction canopy</h3>\r\n            <p>A 31.8 kW gas range has to be under extraction. If the site has no canopy yet, this is the one that suits a 900 mm range — and our survey team will confirm the size before you buy.</p>\r\n            <div class=\"accfoot\">\r\n              <span class=\"accprice\" data-accprice>+ £2,031.99</span>\r\n              <button class=\"btn btn-ghost btn-sm\" type=\"button\" data-add>Add</button>\r\n            </div>\r\n          </div>\r\n\r\n        </div>\r\n      </section>\r\n\r\n      <!-- configuration -->\r\n      <div class=\"card\" style=\"padding:20px;margin-top:22px\">\r\n        <div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:14px\">\r\n          <span class=\"tiny\" style=\"font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-50)\">Your specification</span>\r\n          <button type=\"button\" id=\"clear-all\" class=\"tiny\" style=\"border:0;background:transparent;color:var(--ink-40);cursor:pointer\">✕ Clear all</button>\r\n        </div>\r\n        <div id=\"lines\" style=\"display:grid;gap:8px;font-size:13px\"></div>\r\n        <div style=\"border-top:1px solid var(--line-soft);margin-top:14px;padding-top:12px;display:flex;align-items:baseline;justify-content:space-between\">\r\n          <span style=\"font-weight:700;font-size:14px\">Total</span>\r\n          <span>\r\n            <span class=\"price\" id=\"total\" style=\"font-size:26px\">£3,097.99</span>\r\n            <span class=\"tiny muted\" id=\"total-note\" style=\"display:block;text-align:right\">ex VAT</span>\r\n          </span>\r\n        </div>\r\n        <div class=\"qtyrow\">\r\n          <div class=\"qty\">\r\n            <button type=\"button\" id=\"qty-down\" aria-label=\"Decrease quantity\">−</button>\r\n            <span id=\"qty\">1</span>\r\n            <button type=\"button\" id=\"qty-up\" aria-label=\"Increase quantity\">+</button>\r\n          </div>\r\n          <button class=\"btn btn-primary\" type=\"button\" id=\"add-basket\">Add to basket</button>\r\n        </div>\r\n        <div style=\"display:flex;gap:10px;margin-top:10px\">\r\n          <button class=\"btn btn-ghost btn-sm\" style=\"flex:1\" type=\"button\" id=\"add-quote\">Add to my quote</button>\r\n          <button class=\"btn btn-ghost btn-sm\" style=\"flex:1\" type=\"button\" data-open-chat>Ask Kit</button>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"quotebox\">\r\n        <p><strong>Fitting out a whole kitchen?</strong>Book a live consultation, or have our survey team design the run and quote it as one job.</p>\r\n        <a class=\"btn btn-navy btn-sm\" href=\"tel:01229480001\">Call 01229 480001</a>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</main>\r\n\r\n<!-- ───────── below fold ───────── -->\r\n<div class=\"wrap\" style=\"border-top:1px solid var(--line-soft)\">\r\n  <div style=\"display:grid;grid-template-columns:210px 1fr;gap:44px;padding:48px 0\" class=\"belowfold\">\r\n    <nav class=\"infonav\">\r\n      <p class=\"tiny\" style=\"font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-40);margin:0 0 12px\">Product info</p>\r\n      <ul style=\"list-style:none;margin:0;padding:0;border-left:1px solid var(--line-soft);display:grid;gap:2px\">\r\n        <li><a href=\"#description\">Description</a></li>\r\n        <li><a href=\"#features\">Key features</a></li>\r\n        <li><a href=\"#specifications\">Specifications</a></li>\r\n        <li><a href=\"#install\">Will it work in your kitchen?</a></li>\r\n        <li><a href=\"#running-costs\">Running costs</a></li>\r\n        <li><a href=\"#delivery\">Delivery &amp; installation</a></li>\r\n        <li><a href=\"#warranty\">Warranty &amp; service</a></li>\r\n        <li><a href=\"#documents\">Documents</a></li>\r\n      </ul>\r\n    </nav>\r\n\r\n    <div>\r\n      <section id=\"description\" style=\"border:0;padding:0 0 44px\">\r\n        <h2 style=\"font-size:26px;margin:0 0 16px\">Description</h2>\r\n        <div class=\"panel\">\r\n          <p>Six powerful open-top gas burners over a large fan-assisted electric oven, in 900 mm of floor space. The Falcon Dominator Plus G3101 OTC/P is the range most commercial kitchens end up buying: enough top heat to run a full service, and an oven that takes full 2/1 Gastronorm trays and heats evenly from front to back.</p>\r\n          <p>The hob is semi-sealed pressed stainless steel and lifts out, so the end of a shift is a wipe rather than an argument. Twin cast iron pan supports take the weight of a full stockpot. The oven chamber is vitreous enamelled, with five shelf positions and two shelves supplied, and runs from 120 °C to 270 °C.</p>\r\n          <p><b>This is the propane (LPG) model.</b> If your kitchen runs on mains gas, the identical range on natural gas is the G3101 OTC/N, at the same price. Either way the oven is electric and hardwired, single phase or three phase, so it needs an electrician as well as a Gas Safe engineer. We do both.</p>\r\n        </div>\r\n      </section>\r\n\r\n      <section id=\"features\" style=\"border:0;padding:0 0 44px\">\r\n        <h2 style=\"font-size:26px;margin:0 0 18px\">Key features</h2>\r\n        <div class=\"featgrid\">\r\n          <div><b>Six 5.3 kW burners</b><span>31.8 kW in total. High performance burners heat up fast, so there is less waiting between covers.</span></div>\r\n          <div><b>Fan-assisted 2/1 GN oven</b><span>Even heat across the whole chamber, which is what a static oven cannot do when it is full.</span></div>\r\n          <div><b>Lift-out hob</b><span>Semi-sealed pressed stainless steel. It comes out to clean and goes back without a fight.</span></div>\r\n          <div><b>Vitreous enamelled chamber</b><span>Wipes down, and stays wiped down. It is the difference between a five minute clean and a twenty minute one.</span></div>\r\n          <div><b>Twin cast iron pan supports</b><span>Heavy, flat and long lasting. They will outlast the kitchen they are in.</span></div>\r\n          <div><b>120 to 270 °C</b><span>Low enough to hold and prove, hot enough to roast, in one oven.</span></div>\r\n        </div>\r\n      </section>\r\n\r\n      <section id=\"specifications\" style=\"border:0;padding:0 0 44px\">\r\n        <h2 style=\"font-size:26px;margin:0 0 18px\">Specifications</h2>\r\n        <div class=\"specgrid\">\r\n          <div><span>External dimensions</span><span>943(H) × 900(W) × 857(D) mm</span></div>\r\n          <div><span>Oven internal dimensions</span><span>430(H) × 700(W) × 535(D) mm</span></div>\r\n          <div><span>Gastronorm size</span><span>2/1</span></div>\r\n          <div><span>Shelf size</span><span>700(W) × 535(D) mm</span></div>\r\n          <div><span>Shelf positions</span><span>5</span></div>\r\n          <div><span>Shelves supplied</span><span>2</span></div>\r\n          <div><span>Oven temperature range</span><span>+120 °C to +270 °C</span></div>\r\n          <div><span>Number of hobs</span><span>6</span></div>\r\n          <div><span>Gas type</span><span>Propane (LPG)</span></div>\r\n          <div><span>Gas rating</span><span>31.8 kW / 119,400 Btu/hr</span></div>\r\n          <div><span>Gas rating per burner</span><span>5.3 kW</span></div>\r\n          <div><span>Gas inlet supply</span><span>3/4\" hose</span></div>\r\n          <div><span>Gas hose supplied</span><span>No</span></div>\r\n          <div><span>Electrical rating</span><span>6.5 kW</span></div>\r\n          <div><span>Electrical voltage</span><span>230V or 400V</span></div>\r\n          <div><span>Electrical current</span><span>30A, or L1 14.3A / L2 13.9A</span></div>\r\n          <div><span>Power supply</span><span>Single or 3 phase, hardwired</span></div>\r\n          <div><span>Product weight</span><span>115 kg</span></div>\r\n          <div><span>Packaged weight</span><span>128 kg</span></div>\r\n          <div><span>Material &amp; finish</span><span>Stainless steel</span></div>\r\n          <div><span>Warranty</span><span>2 years parts &amp; labour</span></div>\r\n        </div>\r\n        <p class=\"tiny muted\" style=\"margin-top:14px\">Mobile catering units: 2 years parts only. Electrical installation by a qualified electrician; gas connection by a Gas Safe registered engineer.</p>\r\n      </section>\r\n\r\n      <section id=\"install\" style=\"border:0;padding:0 0 44px\">\r\n        <h2 style=\"font-size:26px;margin:0 0 6px\">Will it work in your kitchen?</h2>\r\n        <p class=\"muted\" style=\"margin:0 0 22px;max-width:64ch\">Four questions. They are the four that hold up an installation once the lorry has been, so it is worth two minutes now.</p>\r\n        <div class=\"checker\">\r\n          <div class=\"checksteps\">\r\n            <div class=\"checkstep\">\r\n              <label for=\"q-gas\">Gas supply on site</label>\r\n              <select id=\"q-gas\">\r\n                <option value=\"lpg\">Propane / LPG, bottled</option>\r\n                <option value=\"natural\">Natural gas, mains</option>\r\n                <option value=\"none\">No gas supply yet</option>\r\n                <option value=\"unsure\">Not sure</option>\r\n              </select>\r\n            </div>\r\n            <div class=\"checkstep\">\r\n              <label for=\"q-elec\">Electrical supply</label>\r\n              <select id=\"q-elec\">\r\n                <option value=\"single\">Single phase, spare 30A way</option>\r\n                <option value=\"single-full\">Single phase, board is full</option>\r\n                <option value=\"three\">Three phase</option>\r\n                <option value=\"unsure\">Not sure</option>\r\n              </select>\r\n            </div>\r\n            <div class=\"checkstep\">\r\n              <label for=\"q-canopy\">Extraction over the cook line</label>\r\n              <select id=\"q-canopy\">\r\n                <option value=\"yes\">Canopy already fitted</option>\r\n                <option value=\"no\">No canopy</option>\r\n                <option value=\"unsure\">Not sure it is big enough</option>\r\n              </select>\r\n            </div>\r\n            <div class=\"checkstep\">\r\n              <label for=\"q-gap\">Gap in the run, in mm</label>\r\n              <input type=\"number\" id=\"q-gap\" value=\"1000\" min=\"600\" max=\"2400\" step=\"10\">\r\n            </div>\r\n            <div class=\"checkstep\">\r\n              <label for=\"q-door\">Narrowest doorway on the route in, in mm</label>\r\n              <input type=\"number\" id=\"q-door\" value=\"900\" min=\"500\" max=\"2000\" step=\"10\">\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"report\">\r\n            <div class=\"rhead\">\r\n              <b>Your site report</b>\r\n              <span id=\"report-score\">Checking…</span>\r\n            </div>\r\n            <ul class=\"rlist\" id=\"report-list\"></ul>\r\n            <div class=\"rfoot\">\r\n              <span>We will confirm all of this on a survey before anything is ordered.</span>\r\n              <a class=\"btn btn-navy btn-sm\" href=\"tel:01229480001\">Book a survey</a>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <section id=\"running-costs\" style=\"border:0;padding:0 0 44px\">\r\n        <h2 style=\"font-size:26px;margin:0 0 6px\">What will it cost to run?</h2>\r\n        <p class=\"muted\" style=\"margin:0 0 22px;max-width:64ch\">Worked out from the appliance's own ratings: 5.3 kW per burner and 6.5 kW for the oven. Put your own unit rates in, because commercial tariffs are all different and a number we made up would be no use to you.</p>\r\n        <div class=\"calc\">\r\n          <div class=\"calcgrid\">\r\n            <div class=\"checkstep\">\r\n              <label for=\"c-burners\">Burners on, average</label>\r\n              <input type=\"number\" id=\"c-burners\" value=\"4\" min=\"0\" max=\"6\" step=\"1\">\r\n            </div>\r\n            <div class=\"checkstep\">\r\n              <label for=\"c-hours\">Hours a day on the hob</label>\r\n              <input type=\"number\" id=\"c-hours\" value=\"6\" min=\"0\" max=\"24\" step=\"0.5\">\r\n            </div>\r\n            <div class=\"checkstep\">\r\n              <label for=\"c-oven\">Hours a day, oven</label>\r\n              <input type=\"number\" id=\"c-oven\" value=\"5\" min=\"0\" max=\"24\" step=\"0.5\">\r\n            </div>\r\n            <div class=\"checkstep\">\r\n              <label for=\"c-days\">Days a week open</label>\r\n              <input type=\"number\" id=\"c-days\" value=\"6\" min=\"1\" max=\"7\" step=\"1\">\r\n            </div>\r\n            <div class=\"checkstep\">\r\n              <label for=\"c-gas\">Your gas rate, p per kWh</label>\r\n              <input type=\"number\" id=\"c-gas\" value=\"7.5\" min=\"0\" max=\"100\" step=\"0.1\">\r\n            </div>\r\n            <div class=\"checkstep\">\r\n              <label for=\"c-elec\">Your electricity rate, p per kWh</label>\r\n              <input type=\"number\" id=\"c-elec\" value=\"26\" min=\"0\" max=\"200\" step=\"0.1\">\r\n            </div>\r\n          </div>\r\n          <div class=\"calcout\">\r\n            <p class=\"lbl\">Estimated cost per week</p>\r\n            <p class=\"big\" id=\"c-week\">£0.00</p>\r\n            <div class=\"calcsplit\">\r\n              <div><b id=\"c-day\">£0.00</b><span>a day</span></div>\r\n              <div><b id=\"c-year\">£0</b><span>a year</span></div>\r\n              <div><b id=\"c-gastotal\">£0.00</b><span>gas, per week</span></div>\r\n              <div><b id=\"c-electotal\">£0.00</b><span>electric, per week</span></div>\r\n            </div>\r\n            <p class=\"calcnote\" id=\"c-note\"></p>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <section id=\"delivery\" style=\"border:0;padding:0 0 44px\">\r\n        <h2 style=\"font-size:26px;margin:0 0 18px\">Delivery &amp; installation</h2>\r\n        <div class=\"panel\">\r\n          <p>Free delivery in 3 to 5 working days, between 8am and 6pm. Selected lines go next day when ordered by 4pm.</p>\r\n          <h3>The kerbside problem, and how we deal with it</h3>\r\n          <p>Anything over 30 kg is a kerbside delivery. This range is 128 kg packaged, so on a standard delivery it comes off the tail lift and stops at the edge of the pavement. That is where most people's day goes wrong.</p>\r\n          <ul>\r\n            <li>Our own vehicles and crews can bring it in, position it and take the packaging away.</li>\r\n            <li>Our Gas Safe engineers make the gas connection. The 3/4\" hose is not supplied with the range.</li>\r\n            <li>Our electricians hardwire the oven, single phase 30A or three phase.</li>\r\n            <li>You get one company, one number, and a commissioned appliance rather than a boxed one.</li>\r\n          </ul>\r\n          <p>Tell us the site when you order and it is priced with the range, not as an afterthought: <a href=\"tel:01229480001\">01229 480001</a>.</p>\r\n        </div>\r\n      </section>\r\n\r\n      <section id=\"warranty\" style=\"border:0;padding:0 0 44px\">\r\n        <h2 style=\"font-size:26px;margin:0 0 18px\">Warranty &amp; service</h2>\r\n        <div class=\"panel\">\r\n          <p>Falcon's manufacturer warranty is <b>2 years parts and labour</b>. On mobile catering units it is 2 years parts only.</p>\r\n          <p>Caterkwik's own engineers cover installation, commissioning and service, so a warranty call and a service call go to the same place you bought it from. Spares and accessories for the Dominator Plus range are stocked.</p>\r\n        </div>\r\n      </section>\r\n\r\n      <section id=\"documents\" style=\"border:0;padding:0 0 10px\">\r\n        <h2 style=\"font-size:26px;margin:0 0 18px\">Documents</h2>\r\n        <div class=\"docs\">\r\n          <a class=\"doc\" href=\"#documents\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"/><path d=\"M14 3v5h5\"/></svg><span style=\"font-weight:700;color:var(--ink);font-size:13.5px\">User manual<span>PDF</span></span></a>\r\n          <a class=\"doc\" href=\"#documents\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"/><path d=\"M14 3v5h5\"/></svg><span style=\"font-weight:700;color:var(--ink);font-size:13.5px\">Spec sheet<span>PDF</span></span></a>\r\n          <a class=\"doc\" href=\"#documents\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"/><path d=\"M14 3v5h5\"/></svg><span style=\"font-weight:700;color:var(--ink);font-size:13.5px\">Exploded diagram<span>PDF</span></span></a>\r\n          <a class=\"doc\" href=\"#documents\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"/><path d=\"M14 3v5h5\"/></svg><span style=\"font-weight:700;color:var(--ink);font-size:13.5px\">Brochure<span>PDF</span></span></a>\r\n          <a class=\"doc\" href=\"#documents\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"/><path d=\"M14 3v5h5\"/></svg><span style=\"font-weight:700;color:var(--ink);font-size:13.5px\">Installation &amp; servicing<span>PDF</span></span></a>\r\n        </div>\r\n      </section>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- ───────── alternatives ───────── -->\r\n<div class=\"wrap\">\r\n  <section>\r\n    <div class=\"sechead\">\r\n      <div>\r\n        <h2>If this one is not it</h2>\r\n        <p>Three ranges we would put in front of you instead, and the honest reason for each.</p>\r\n      </div>\r\n    </div>\r\n    <div class=\"alts\">\r\n      <div class=\"alt\">\r\n        <div class=\"ph\"><img src=\"/assets/img/g3101-otc-n.jpg\" alt=\"Falcon G3101 OTC/N\"></div>\r\n        <div class=\"body\">\r\n          <h3>Falcon G3101 OTC/N</h3>\r\n          <p>The identical range on <b>natural gas</b>. If your kitchen is on the mains, this is the one you want, not the propane model.</p>\r\n          <div class=\"pr\" data-alt=\"3097.99\">£3,097.99 <span class=\"tiny muted\" data-altnote>ex VAT</span></div>\r\n        </div>\r\n      </div>\r\n      <div class=\"alt\">\r\n        <div class=\"ph\"><img src=\"/assets/img/lincat-phdr01.jpg\" alt=\"Lincat Phoenix PHDR01/N\"></div>\r\n        <div class=\"body\">\r\n          <h3>Lincat Phoenix PHDR01/N</h3>\r\n          <p>Six burners, fan-assisted dual fuel, natural gas only. £141.60 inc VAT cheaper if budget is the deciding factor.</p>\r\n          <div class=\"pr\" data-alt=\"2979.99\">£2,979.99 <span class=\"tiny muted\" data-altnote>ex VAT</span></div>\r\n        </div>\r\n      </div>\r\n      <div class=\"alt\">\r\n        <div class=\"ph\"><img src=\"/assets/img/blueseal-ge506d.jpg\" alt=\"Blue Seal Evolution GE506D-P\"></div>\r\n        <div class=\"body\">\r\n          <h3>Blue Seal GE506D-P</h3>\r\n          <p>Also propane, but a <b>static</b> oven rather than fan-assisted, and £235.20 inc VAT more. Only if you prefer the Blue Seal build.</p>\r\n          <div class=\"pr\" data-alt=\"3294.00\">£3,294.00 <span class=\"tiny muted\" data-altnote>ex VAT</span></div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <section style=\"border:0;padding-top:0\">\r\n    <div class=\"expert\">\r\n      <div>\r\n        <h2>Not sure this is the right range?</h2>\r\n        <p>Ask Kit. He knows this one properly: the gas and phase question, what it takes to install, what it costs to run, and when a different range would serve you better.</p>\r\n      </div>\r\n      <button class=\"btn btn-primary\" type=\"button\" data-open-chat>Ask Kit a question</button>\r\n    </div>\r\n  </section>\r\n</div>\r\n\r\n","markup":"<!-- ───────── sticky config bar ───────── -->\r\n<div class=\"configbar\" id=\"configbar\">\r\n  <div class=\"wrap\">\r\n    <div class=\"configname\">\r\n      <b>Falcon G3101 OTC/P · <span id=\"bar-fuel\">Propane</span>, <span id=\"bar-phase\">single phase</span></b>\r\n      <span id=\"bar-extras\">No accessories added</span>\r\n    </div>\r\n    <div class=\"total\">\r\n      <div class=\"t\" id=\"bar-total\">£3,097.99</div>\r\n      <div class=\"n\" id=\"bar-note\">ex VAT</div>\r\n    </div>\r\n    <button class=\"btn btn-primary btn-sm\" type=\"button\" id=\"bar-add\">Add to basket</button>\r\n  </div>\r\n</div>\r\n\r\n<!-- ───────── chat ───────── -->\r\n<div class=\"chat\" id=\"chat\" role=\"dialog\" aria-label=\"Chat with Kit, the Caterkwik product expert\">\r\n  <div class=\"chathead\">\r\n    <div class=\"avatar\">K</div>\r\n    <div class=\"who\">\r\n      <b>Kit · Caterkwik Product Expert</b>\r\n      <span>AI assistant · Humans 8am to 6pm, Mon to Sat</span>\r\n    </div>\r\n    <button type=\"button\" id=\"chat-close\" aria-label=\"Close chat\">×</button>\r\n  </div>\r\n  <div class=\"log\" id=\"log\"></div>\r\n  <div class=\"suggest\" id=\"suggest\">\r\n    <button type=\"button\">Will it run on mains gas?</button>\r\n    <button type=\"button\">What does it need electrically?</button>\r\n    <button type=\"button\">Can you install it?</button>\r\n  </div>\r\n  <form class=\"composer\" id=\"composer\">\r\n    <input id=\"chat-input\" placeholder=\"Ask about this range...\" maxlength=\"600\" aria-label=\"Message\">\r\n    <button type=\"submit\" id=\"chat-send\" aria-label=\"Send message\">\r\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"17\" height=\"17\"><path d=\"M22 2 11 13M22 2l-7 20-4-9-9-4z\"/></svg>\r\n    </button>\r\n  </form>\r\n  <p class=\"chatfoot\">AI assistant. Conversations are saved so we can improve the answers. For orders and account queries call 01229 480001.</p>\r\n</div>\r\n\r\n<div class=\"launcher\">\r\n  <a class=\"launchpill\" href=\"tel:01229480001\">\r\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--navy)\" stroke-width=\"2\" width=\"17\" height=\"17\"><path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z\"/></svg>\r\n    <span>01229 480001</span>\r\n  </a>\r\n  <button class=\"launchbtn\" type=\"button\" id=\"launch\" aria-label=\"Chat with Kit, the Caterkwik product expert\">\r\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.8-.8L3 21l1.9-4.6A8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5Z\"/></svg>\r\n    <span class=\"dot\" id=\"unread\" hidden></span>\r\n  </button>\r\n</div>","scripts":[{"src":"/assets/app.js"},{"src":"/assets/chat.js"}]}